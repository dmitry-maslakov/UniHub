# TLS for the hub's address, certificates from Let's Encrypt.
# caddy sets X-Forwarded-For to the client's address itself (it trusts no
# proxy in front of it), so the app and Better Auth read the real one.
{$DOMAIN} {
	# external connectors: gRPC over TLS, to the app's plain gRPC port
	@grpc path /unihub.ingest.v1.Ingest/*
	reverse_proxy @grpc h2c://app:50051

	reverse_proxy app:3000
}
