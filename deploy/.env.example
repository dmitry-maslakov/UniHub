# copy to deploy/.env on the server, then: docker compose -f deploy/compose.yml up -d --build

# the hub's public address (caddy gets its certificate) and the database
# password: it goes into a URL, so letters and digits (openssl rand -hex 32)
DOMAIN="hub.example.com"
POSTGRES_PASSWORD=""

# openssl rand -base64 32; the address as users see it
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://hub.example.com"

# required in production: sign-up and password reset links go by mail
SMTP_URL="smtp://user:pass@smtp.example.com:587"
MAIL_FROM="UniHub <no-reply@hub.example.com>"

PLUGINS="office-text,plain-text"
# with "canvas" in PLUGINS, once the school knows (README, Canvas)
# CANVAS_URL="https://canvas.example.edu"
# CANVAS_TOKEN=""

# search (README, Deploying search): OpenSearch and the models, some 13 GB of
# memory, with vm.max_map_count=262144 on the host. Uncomment to turn it on
# COMPOSE_PROFILES="search"
# OPENSEARCH_URL="http://opensearch:9200"
# EMBEDDING_URL="http://embedder"
# EMBEDDING_QUERY_URL="http://embedder-query"
# EMBEDDING_MODEL="bge-m3-5617a9f6"
# EMBEDDING_DIMENSIONS="1024"
# RERANK_URL="http://reranker"
# the best contents it reorders, 20 by default; fewer for a faster search on
# amd64 (README, Deploying search)
# RERANK_CANDIDATES="20"
# TEI has a tag per arch: this one on an arm64 server, cpu-1.9.4 on amd64
# TEI_TAG="cpu-arm64-1.9.4"
# the cores each model server may take, none unless set (no more than the
# server has); OpenSearch's memory (4g) and its heap (2g), at most half of it
# TEI_CPUS="6"
# OPENSEARCH_MEMORY="4g"
# OPENSEARCH_HEAP="2g"

# Prometheus metrics for a scraper on the compose network (README, Metrics):
# the port isn't published, keep it so
# METRICS_PORT="9464"

# optional
CONNECTOR_TOKENS=""
TRUSTED_ORIGINS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
