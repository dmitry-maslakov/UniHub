# copy to deploy/.env on the server, then: docker compose -f deploy/compose.yml up -d --build

# the hub's public address (caddy gets its certificate) and the database
# password: it goes into a URL, so letters and digits (openssl rand -hex 32)
DOMAIN="hub.example.com"
POSTGRES_PASSWORD=""

# openssl rand -base64 32; the address as users see it
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://hub.example.com"

# required in production: sign-up and password reset links go by mail
SMTP_URL="smtp://user:pass@smtp.example.com:587"
MAIL_FROM="UniHub <no-reply@hub.example.com>"

PLUGINS="office-text"

# optional
CONNECTOR_TOKENS=""
TRUSTED_ORIGINS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
