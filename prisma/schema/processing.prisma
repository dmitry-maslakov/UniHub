// What a content processor made of some content. Keyed by the content, so a
// file shared by several courses is processed once; a new processor version
// gets its own row.
model Representation {
  hash      String
  processor String
  version   Int
  parts     Json
  createdAt DateTime @default(now())

  @@id([hash, processor, version])
}

// What a content expander made of some content (an archive): its entries,
// [{ path, hash, size }], each stored as a content of its own. Keyed as
// Representation is.
model Expansion {
  hash      String
  expander  String
  version   Int
  entries   Json
  createdAt DateTime @default(now())

  @@id([hash, expander, version])
  // the expansions with an entry holding a content (entries @> ...)
  @@index([entries(ops: JsonbPathOps)], type: Gin)
}
