// a subject as we know it, portal courses get linked to it
model Course {
  id    String       @id @default(uuid())
  slug  String       @unique
  name  String
  links CourseLink[]
}

// which portal courses a course is made of; a portal course belongs to at
// most one course. Canvas makes a new course every year, so the year is here
model CourseLink {
  portalCourseId String       @id
  portalCourse   PortalCourse @relation(fields: [portalCourseId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // academic year the portal course is for; null when it spans years (acs)
  year           Int?

  @@index([courseId])
}

// a course as it exists in one portal (canvas course, acs group, teams team...).
// portal is a plugin id, not an enum, so a new plugin doesn't need a migration
model PortalCourse {
  id         String      @id @default(uuid())
  portal     String
  externalId String
  name       String
  url        String?
  meta       Json?
  updatedAt  DateTime    @updatedAt
  items      Item[]
  files      File[]
  link       CourseLink?

  @@unique([portal, externalId])
}

// anything a portal publishes that isn't a file: posts, announcements, pages...
model Item {
  id             String        @id @default(uuid())
  portal         String
  externalId     String
  portalCourseId String?
  portalCourse   PortalCourse? @relation(fields: [portalCourseId], references: [id], onDelete: Cascade)
  kind           String
  title          String?
  url            String?
  publishedAt    DateTime?
  raw            Json
  // set when the portal says it's gone, cleared when it comes back
  removedAt      DateTime?
  updatedAt      DateTime      @updatedAt
  files          File[]

  @@unique([portal, externalId])
}

model File {
  id              String        @id @default(uuid())
  portal          String
  externalId      String
  portalCourseId  String?
  portalCourse    PortalCourse? @relation(fields: [portalCourseId], references: [id], onDelete: Cascade)
  itemId          String?
  item            Item?         @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name            String
  // folder inside the portal, e.g. "Lectures/2026"
  path            String        @default("")
  url             String?
  // as reported by the portal, may be rounded
  size            BigInt?
  mime            String?
  sourceUpdatedAt DateTime?
  // sha256 of the content once storage has it
  contentHash     String?
  // the portal changed the file since its content was stored
  contentStale    Boolean       @default(false)
  removedAt       DateTime?
  updatedAt       DateTime      @updatedAt

  @@unique([portal, externalId])
}
