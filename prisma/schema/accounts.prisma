// users' own accounts of portals (README, Portal accounts), one per user and
// portal. userId is identity's, not a foreign key: modules keep their own
// tables, and a user's delete takes theirs (UserDeletedEvent)
model PortalAccount {
  id         String            @id
  userId     String
  portal     String
  // the portal's site it was linked with (the records' instance, catalog),
  // '' for a portal of one site
  instance   String            @default("")
  // how it was linked: token
  mode       String
  // the portal's own id for its user, never a name or an email
  portalUser String
  // linked, expired or revoked
  status     String            @default("linked")
  expiresAt  DateTime?
  credential PortalCredential?

  @@unique([userId, portal])
}

// an account's credential, sealed (CredentialVault), in a table of its own
// so nothing that reads accounts reads it; deleted with its account
model PortalCredential {
  accountId String        @id
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sealed    String
  updatedAt DateTime      @updatedAt
}

// A user's pick of a public portal's course (README, Public portals): the
// user shows it among their courses. Everyone reads a public portal's
// courses, picked or not, so a pick gives nothing to read. userId is
// identity's and portalCourseId catalog's, not foreign keys
// (PortalAccount): a user's delete takes their picks (UserDeletedEvent).
// `into` is the portal course of the user's own account it's shown with
// (README, Matching), catalog's id as portalCourseId is; null on its own
model Pick {
  userId         String
  portalCourseId String
  into           String?
  createdAt      DateTime @default(now())

  @@id([userId, portalCourseId])
}

// A portal course its user hides (README, Hidden courses): read as before
// by every route, and left out of the user's list of courses. No row is a
// course shown. userId is identity's and portalCourseId catalog's, not
// foreign keys (Pick): a user's delete takes theirs
model HiddenCourse {
  userId         String
  portalCourseId String

  @@id([userId, portalCourseId])
}
