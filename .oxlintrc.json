                  "!**/storage/contracts.js",
                  "**/processing/**",
                  "!**/processing/contracts.js",
                  "**/plugins/**",
                  "!**/plugins/contracts.js"
                ],
                "message": "other modules are used through their contracts.ts"
              }
            ]
          }
        ]
      }
    },
