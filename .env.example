DATABASE_URL="postgresql://unihub:unihub@localhost:5432/unihub"

# what this process runs (README, Running the API and the worker apart): all
# of it, or in two processes of one image, "api" (HTTP, MCP and gRPC, which
# only add work) and "worker" (the queues, crons, schedules, push connectors
# and the outbox relay, with no server); both share STORAGE_PATH
APP_ROLE="all"

# where file content is kept, and the most one file may take, in MiB
STORAGE_PATH="./data/blobs"
STORAGE_MAX_FILE_MB=1024

REDIS_URL="redis://localhost:6379"

# built-in plugins to turn on, comma separated
PLUGINS="office-text,plain-text"

# the canvas connector, on when "canvas" is in PLUGINS (README, Canvas): the
# school's Canvas, the owner's access token, and an optional user agent
# CANVAS_URL="https://canvas.example.edu"
# CANVAS_TOKEN=""
# CANVAS_USER_AGENT="course-sync"

# a poll running longer is aborted; shutdown waits this long for a push
# connector; one that ended or failed runs again, waiting longer each time it
# ends soon again, up to this long
CONNECTOR_POLL_TIMEOUT_MINUTES=60
CONNECTOR_STOP_SECONDS=10
CONNECTOR_RESTART_MAX_SECONDS=60
# a worker runs the push connectors; with more than one, false on the others
RUN_CONNECTORS=true

# external connectors over gRPC, started once a token is set: "portal=token,…"
GRPC_URL="127.0.0.1:50051"
CONNECTOR_TOKENS=""

# auth: a random secret (openssl rand -base64 32) and where users reach the hub
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# mail for sign-up and password reset; without SMTP_URL mails are only logged
SMTP_URL=""
MAIL_FROM="UniHub <no-reply@localhost>"

# other sites (the web app) allowed to call the API with cookies, comma separated
TRUSTED_ORIGINS=""

# proxies in front of the app that set X-Forwarded-For (caddy in deploy/: 1)
TRUST_PROXY=0

# Prometheus metrics for a scraper, on a port of their own (README, Metrics):
# none unless set, never the app's PORT; never publish it
METRICS_PORT=""

# Google sign-in, on when both are set
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# search: OpenSearch, which docker compose up -d starts; empty, nothing is
# indexed (README, Search index)
OPENSEARCH_URL="http://localhost:9200"
# by meaning too, with an embedder: docker compose --profile models up -d,
# then EMBEDDING_URL="http://localhost:8081", EMBEDDING_MODEL="bge-m3-5617a9f6"
# and EMBEDDING_DIMENSIONS="1024". Empty, by the words alone. Queries go to
# EMBEDDING_QUERY_URL when it's set
# TEI has a tag per arch: cpu-arm64-1.9.4 on Apple silicon, cpu-1.9.4 on amd64
TEI_TAG="cpu-arm64-1.9.4"
EMBEDDING_URL=""
EMBEDDING_QUERY_URL=""
EMBEDDING_MODEL=""
EMBEDDING_DIMENSIONS=""
# the best contents of a search reordered by a reranker, which the models
# profile starts too: RERANK_URL="http://localhost:8082". Empty, in the
# index's order. RERANK_CANDIDATES says how many, 20 by default
RERANK_URL=""
