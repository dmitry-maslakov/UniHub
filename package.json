{
  "name": "unihub",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/ libs/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma generate && npm run -s proto:generate",
    "proto:generate": "proto-loader-gen-types --longs=Number --grpcLib=@grpc/grpc-js --importFileExtension=.js -O src/ingest/infrastructure/grpc/generated proto/ingest.proto",
    "auth:generate": "auth generate --config src/identity/auth.cli.ts --output prisma/schema/identity.prisma --yes",
    "auth:create-admin": "auth create-admin --config src/identity/auth.cli.ts"
  },
  "dependencies": {
