{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack"
  },
  "projects": {
    "plugin-sdk": {
      "type": "library",
      "root": "libs/plugin-sdk",
      "entryFile": "index",
      "sourceRoot": "libs/plugin-sdk/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugin-sdk/tsconfig.lib.json"
      }
    },
    "plugins/office-text": {
      "type": "library",
      "root": "libs/plugins/office-text",
      "entryFile": "index",
      "sourceRoot": "libs/plugins/office-text/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugins/office-text/tsconfig.lib.json"
      }
    }
  }
}