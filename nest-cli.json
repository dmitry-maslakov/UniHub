{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack"
  },
  "projects": {
    "kernel": {
      "type": "library",
      "root": "libs/kernel",
      "entryFile": "index",
      "sourceRoot": "libs/kernel/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kernel/tsconfig.lib.json"
      }
    },
    "plugin-sdk": {
      "type": "library",
      "root": "libs/plugin-sdk",
      "entryFile": "index",
      "sourceRoot": "libs/plugin-sdk/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugin-sdk/tsconfig.lib.json"
      }
    },
    "plugins/ocr": {
      "type": "library",
      "root": "libs/plugins/ocr",
      "entryFile": "index",
      "sourceRoot": "libs/plugins/ocr/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugins/ocr/tsconfig.lib.json"
      }
    },
    "plugins/office-text": {
      "type": "library",
      "root": "libs/plugins/office-text",
      "entryFile": "index",
      "sourceRoot": "libs/plugins/office-text/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugins/office-text/tsconfig.lib.json"
      }
    },
    "plugins/plain-text": {
      "type": "library",
      "root": "libs/plugins/plain-text",
      "entryFile": "index",
      "sourceRoot": "libs/plugins/plain-text/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugins/plain-text/tsconfig.lib.json"
      }
    },
    "plugins/archives": {
      "type": "library",
      "root": "libs/plugins/archives",
      "entryFile": "index",
      "sourceRoot": "libs/plugins/archives/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugins/archives/tsconfig.lib.json"
      }
    },
    "plugins/canvas": {
      "type": "library",
      "root": "libs/plugins/canvas",
      "entryFile": "index",
      "sourceRoot": "libs/plugins/canvas/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugins/canvas/tsconfig.lib.json"
      }
    },
    "plugins/website": {
      "type": "library",
      "root": "libs/plugins/website",
      "entryFile": "index",
      "sourceRoot": "libs/plugins/website/src",
      "compilerOptions": {
        "tsConfigPath": "libs/plugins/website/tsconfig.lib.json"
      }
    }
  }
}
