{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2024",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@app/kernel": [
        "./libs/kernel/src/index.ts"
      ],
      "@app/kernel/*": [
        "./libs/kernel/src/*"
      ],
      "@app/plugin-sdk": [
        "./libs/plugin-sdk/src/index.ts"
      ],
      "@app/plugin-sdk/*": [
        "./libs/plugin-sdk/src/*"
      ],
      "@app/plugins/archives": [
        "./libs/plugins/archives/src/index.ts"
      ],
      "@app/plugins/archives/*": [
        "./libs/plugins/archives/src/*"
      ],
      "@app/plugins/canvas": [
        "./libs/plugins/canvas/src/index.ts"
      ],
      "@app/plugins/canvas/*": [
        "./libs/plugins/canvas/src/*"
      ],
      "@app/plugins/office-text": [
        "./libs/plugins/office-text/src/index.ts"
      ],
      "@app/plugins/office-text/*": [
        "./libs/plugins/office-text/src/*"
      ],
      "@app/plugins/plain-text": [
        "./libs/plugins/plain-text/src/index.ts"
      ],
      "@app/plugins/plain-text/*": [
        "./libs/plugins/plain-text/src/*"
      ]
    }
  },
  // web/ is a project of its own (web/tsconfig.json)
  "exclude": ["node_modules", "dist", "web"]
}
